{
  "name": "myrepos",
  "productName": "MyRepos",
  "version": "0.1.4",
  "private": true,
  "description": "A multi-account, multi-provider Git desktop client.",
  "author": "Debdutta-Panda",
  "repository": {
    "type": "git",
    "url": "https://github.com/Debdutta-Panda/MyGit.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-forge make",
    "make": "npm run build && electron-forge make",
    "package:win": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "package:mac": "npm run build && electron-forge make --platform=darwin",
    "package:linux": "npm run build && electron-forge make --platform=linux",
    "deploy": "node scripts/deploy.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@react-symbols/icons": "^1.4.1",
    "@tabler/icons-react": "^3.46.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "devicon": "^2.17.0",
    "electron": "^44.4.1",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.13",
    "monaco-editor": "^0.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
